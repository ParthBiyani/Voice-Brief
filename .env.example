# ─── Core ────────────────────────────────────────────────────────────────────
VB_ENV=local
VB_LOG_LEVEL=INFO
VB_TIMEZONE=Asia/Kolkata

# ─── Datastores ──────────────────────────────────────────────────────────────
# Non-default host ports so VoiceBrief never collides with another local stack.
VB_POSTGRES_DSN=postgresql+psycopg://voicebrief:voicebrief@localhost:55432/voicebrief
VB_QDRANT_URL=http://localhost:56333

VB_S3_ENDPOINT=http://localhost:59000
VB_S3_ACCESS_KEY=voicebrief
VB_S3_SECRET_KEY=voicebrief
VB_S3_BUCKET=voicebrief-media

# ─── LLM (BYOK) ──────────────────────────────────────────────────────────────
# provider: anthropic | ollama | echo
VB_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
VB_LLM_SCRIPT_MODEL=claude-sonnet-5-5
VB_LLM_UTILITY_MODEL=claude-haiku-5-5   # ranking, summaries, Q&A. Try claude-sonnet-5-5 or compare with scripts/compare_models.py
# How hard the script writer thinks: low | medium | high.
# VB_SCRIPT_EFFORT=medium
VB_OLLAMA_URL=http://localhost:11434
VB_OLLAMA_SCRIPT_MODEL=qwen2.5:7b-instruct-q4_K_M

# Hard daily spend ceiling in INR; the ledger kill-switch trips above this.
VB_DAILY_BUDGET_INR=50

# ─── Embeddings ──────────────────────────────────────────────────────────────
VB_EMBED_MODEL=BAAI/bge-small-en-v1.5
VB_EMBED_DIM=384

# ─── Speech ──────────────────────────────────────────────────────────────────
# edge        Microsoft neural voices. Free, no key, sounds human. Needs internet and sends
#             each sentence to Microsoft. The default.
# openai      gpt-4o-mini-tts, directed in words ("warm, conversational"). Paid, needs a key.
# elevenlabs  The most natural voices. Paid, needs a key.
# kokoro      Fully local, no internet. Run `voicebrief tts setup` once (~350 MB).
# null        Silence. For tests.
VB_TTS_ENGINE=edge
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# Leave the voices unset for each engine's default pair (a woman asks, a man answers).
# A name is used only if it belongs to the chosen engine.
# VB_TTS_VOICE_HOST_A_EN=en-US-AvaMultilingualNeural
# VB_TTS_VOICE_HOST_B_EN=en-US-AndrewMultilingualNeural
# VB_TTS_SPEED=1.0

# ─── Sources (optional; raises rate limits) ──────────────────────────────────
GITHUB_TOKEN=

# ─── Delivery (each channel is off until configured) ─────────────────────────
# Slack: a bot token with chat:write, files:write, channels:read, channels:history, and
# the channel id. The app-level token (xapp-, scope connections:write, Socket Mode on, bot
# event message.channels) lets the bot answer questions asked in the channel.
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=
# SLACK_APP_TOKEN=
# Email: any SMTP server (for Gmail, use an app password).
# VB_SMTP_HOST=smtp.gmail.com
# VB_SMTP_PORT=587
# VB_SMTP_USER=
# VB_SMTP_PASSWORD=
# VB_MAIL_FROM=
# VB_EMAIL_TO=
# Where the web app can be reached from your phone; used for the link in a digest.
# VB_PUBLIC_URL=http://192.168.1.20:8000

# ─── Web app ─────────────────────────────────────────────────────────────────
# Required for `voicebrief serve --host 0.0.0.0` (a phone on your network). Anyone with
# this can generate briefs, which spend money, and play your audio.
# VB_API_TOKEN=

# ─── ProjectMind (optional personal memory) ───────────────────────────────────
# Command that runs the ProjectMind CLI, e.g.
#   D:\Projects\ProjectMind\.venv\Scripts\python.exe -m projectmind.cli
# Unset: `projectmind` is looked up on PATH. VB_PROJECTMIND_ENABLED=false turns it off.
# VB_PROJECTMIND_CMD=
# VB_PROJECTMIND_PROJECT_PATH=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=

# ─── Ingestion guardrails ────────────────────────────────────────────────────
VB_MAX_ITEMS_PER_RUN=1500
VB_MAX_ITEMS_TO_RANK=60
VB_MAX_STORIES_PER_EPISODE=10

# ─── Backups ───────────────────────────────────────────────────────
# Dumps of the database and copies of the audio, kept outside Docker. Unset: a folder
# under %LOCALAPPDATA%\VoiceBrief\backups.
# VB_BACKUP_DIR=
# VB_BACKUP_KEEP=7

# ─── Costs ─────────────────────────────────────────────────────────
# Dollar prices are converted to rupees for the ledger and the daily budget. The default
# was last set in June 2026; update it when the exchange rate moves.
# VB_USD_TO_INR=100
